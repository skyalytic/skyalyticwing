# Environment Variables Example
# Copy this file to .env and fill in your values

# NestJS backend (listens on 127.0.0.1)
PORT=19111

# Authentication
# Set a unique random secret before enabling remote access.
# The backend enables token authentication when this variable is non-empty.
SKYALYTICWING_AUTH_TOKEN=
# Optional exact browser origins, comma-separated, for a trusted reverse proxy.
# Local desktop origin is allowed automatically; Vite :1421 only outside production.
SKYALYTICWING_ALLOWED_ORIGINS=
# Desktop binds loopback. A non-loopback host requires a >=32-character token.
SKYALYTICWING_HOST=127.0.0.1
# Isolated bash execution requires a working Docker daemon and this image.
SKYALYTICWING_SANDBOX_IMAGE=node:22-bookworm-slim
# Explicit legacy host fallback; keep false for isolated execution.
SKYALYTICWING_ALLOW_UNISOLATED_EXECUTION=false
# Node does not load .env automatically: export these values or use --env-file=.env.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/skyalyticwing
# docker-compose requires POSTGRES_PASSWORD from the deployment environment.
POSTGRES_PASSWORD=change-me-in-env

# Redis (optional)
REDIS_URL=redis://localhost:6379

# AI Providers
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Channels (optional)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=

# Logging
SKYALYTICWING_LOG_LEVEL=info

# Optional private release deployment; keep these unset for local builds.
WING_DEPLOY_HOST=
WING_RELEASE_DIRECTORY=
WING_RELEASE_BASE_URL=
WING_UPDATE_FEED_URL=
