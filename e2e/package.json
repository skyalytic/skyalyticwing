{
  "name": "@skyalyticwing/e2e",
  "version": "1.0.0",
  "private": true,
  "description": "SkyalyticWing browser-level E2E tests (Playwright)",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "clean": "node -e \"require('fs').rmSync('test-results',{recursive:true,force:true});require('fs').rmSync('playwright-report',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/ws": "^8.5.0",
    "ws": "^8.20.0"
  }
}
