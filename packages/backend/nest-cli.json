{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "extensions/bundled/**/manifest.json",
        "watchAssets": true
      },
      {
        "include": "extensions/bundled/**/GUIDE.md",
        "watchAssets": true
      },
      {
        "include": "extensions/bundled/**/references/**/*",
        "watchAssets": true
      },
      {
        "include": "extensions/bundled/**/*.cjs",
        "watchAssets": true
      },
      {
        "include": "extensions/bundled/**/native/bin/*",
        "watchAssets": true
      }
    ]
  }
}
