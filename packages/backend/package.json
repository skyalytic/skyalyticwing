  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "SkyalyticWing community backend",
  "private": true,
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "type-check": "tsc --noEmit",
    "test": "node ../../scripts/run-backend-tests.cjs",
    "test:watch": "node ../../scripts/run-backend-tests.cjs --watch",
    "test:coverage": "node ../../scripts/run-backend-tests.cjs --coverage",
    "test:e2e": "node ../../scripts/run-backend-tests.cjs --config ./test/jest-e2e.json --forceExit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "node ../../scripts/build-computer-use-native.cjs"
  },
  "dependencies": {
