{
  "name": "@skyalyticwing/cli",
  "version": "2.1.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "SkyalyticWing CLI - 无头运行时命令行（连接后端 HTTP/WS API，零运行时依赖）",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "skyalyticwing": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "cli": "node dist/cli.js",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
