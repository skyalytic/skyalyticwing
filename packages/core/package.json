{
  "name": "@skyalyticwing/core",
  "version": "2.1.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "SkyalyticWing Core - Gateway, Agent, Tool, Permission, Memory, Plugin systems",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./gateway": {
      "import": "./dist/gateway/index.js",
      "types": "./dist/gateway/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent/index.js",
      "types": "./dist/agent/index.d.ts"
    },
    "./permission": {
      "import": "./dist/permission/index.js",
      "types": "./dist/permission/index.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    },
    "./channel": {
      "import": "./dist/channel/index.js",
      "types": "./dist/channel/index.d.ts"
    },
    "./model": {
      "import": "./dist/model/index.js",
      "types": "./dist/model/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin/index.js",
      "types": "./dist/plugin/index.d.ts"
    },
    "./task": {
      "import": "./dist/task/index.js",
      "types": "./dist/task/index.d.ts"
    },
    "./hook": {
      "import": "./dist/hook/index.js",
      "types": "./dist/hook/index.d.ts"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "types": "./dist/storage/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./cron": {
      "import": "./dist/cron/index.js",
      "types": "./dist/cron/index.d.ts"
    },
    "./daemon": {
      "import": "./dist/daemon/index.js",
      "types": "./dist/daemon/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    },
    "./acp": {
      "import": "./dist/acp/index.js",
      "types": "./dist/acp/index.d.ts"
    },
    "./security": {
      "import": "./dist/security/index.js",
      "types": "./dist/security/index.d.ts"
    },
    "./state": {
      "import": "./dist/state/index.js",
      "types": "./dist/state/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:watch": "vitest",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@skyalyticwing/shared": "workspace:*",
    "hono": "^4.12.0",
    "ws": "^8.20.0",
    "zod": "^3.23.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "uuid": "^10.0.0",
    "pino": "^9.0.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "tsdown": "^0.21.0"
  }
}
