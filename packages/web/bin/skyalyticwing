#!/bin/sh
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ -x "$SCRIPT_DIR/../../../../../MacOS/node" ]; then
  exec "$SCRIPT_DIR/../../../../../MacOS/node" "$SCRIPT_DIR/skyalyticwing.cjs" "$@"
fi
if [ -x "$SCRIPT_DIR/../../../../node" ]; then
  exec "$SCRIPT_DIR/../../../../node" "$SCRIPT_DIR/skyalyticwing.cjs" "$@"
fi
exec node "$SCRIPT_DIR/skyalyticwing.cjs" "$@"
